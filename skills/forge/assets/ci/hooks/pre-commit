#!/bin/bash
# FORGE pre-commit hook
# Validates governance state/evidence coupling for local commits.
#
# Install: cp ci/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

CHANGED_FILES=$(git diff --cached --name-only)

# Task-ledger changes must carry EVALUATION.md — but only in repos that use
# one (Lightweight repos may record gate outcomes in task files instead).
if echo "$CHANGED_FILES" | grep -qE "^docs/forge/(TASKS.yaml|TASKS.index.yaml|tasks/.*[.]ya?ml)$"; then
  if [ -f "docs/forge/EVALUATION.md" ] && ! echo "$CHANGED_FILES" | grep -q "^docs/forge/EVALUATION.md$"; then
    echo ""
    echo "FORGE: Commit rejected - local task ledger changed without EVALUATION.md."
    echo ""
    echo "  Update docs/forge/EVALUATION.md in the same commit as task-state changes."
    echo ""
    exit 1
  fi
fi

# Governed-paths advisory (warn, never block): code changes under governed_paths
# with no docs/forge/ update at all may be ungoverned work. WIP commits are
# legal; this is a nudge, and CI remains the durable backstop.
AI_MD="docs/forge/AI.md"
if [ -f "$AI_MD" ]; then
  GOVERNED=$(grep -m1 -E '^[[:space:]]*governed_paths:' "$AI_MD" 2>/dev/null \
    | sed 's/^[[:space:]]*governed_paths:[[:space:]]*//')
  if [ -n "$GOVERNED" ] && ! echo "$CHANGED_FILES" | grep -q "^docs/forge/"; then
    HIT=""
    while IFS= read -r prefix; do
      prefix=$(echo "$prefix" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s|/*$||')
      [ -n "$prefix" ] || continue
      if echo "$CHANGED_FILES" | grep -q "^${prefix}/"; then
        HIT="$prefix"
        break
      fi
    done < <(printf '%s\n' "$GOVERNED" | tr ',' '\n')
    if [ -n "$HIT" ]; then
      echo "FORGE: note - commit touches governed path '$HIT' with no docs/forge/ update."
      echo "  If this is task work, run the checkpoint gates (forge_next_gate.py) before completing."
    fi
  fi
fi

exit 0
