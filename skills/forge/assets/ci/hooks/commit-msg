#!/bin/bash
# FORGE commit-msg hook
# Validates:
#   1. Subject line follows Conventional Commits format
#   2. No AI attribution / tool-marketing text
#   3. FORGE trailers, IF PRESENT, are well-formed (they are optional)
#
# FORGE trailers are optional. Gate outcomes are recorded in the task file's
# `gates:` block (machine-readable, verifiable), not asserted in the commit.
# `FORGE-task: <id>` is a useful durable commit->task link when you want it.
#
# Install: cp ci/hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge and revert commits generated by git
if echo "$COMMIT_MSG" | grep -qE "^(Merge |Revert \")"; then
  exit 0
fi

# --- Conventional Commits subject line validation ---

SUBJECT=$(echo "$COMMIT_MSG" | head -1)
CC_PATTERN='^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\([a-zA-Z0-9_/.-]+\))?(!)?: .+'

if ! echo "$SUBJECT" | grep -qE "$CC_PATTERN"; then
  echo ""
  echo "FORGE: Commit rejected - subject line does not follow Conventional Commits format."
  echo ""
  echo "  Required: <type>[optional scope]: <description>"
  echo "  Types: feat, fix, docs, style, refactor, test, chore, build, ci, perf, revert"
  echo ""
  echo "  Example: feat(auth): add JWT token validation"
  echo ""
  echo "  Got: $SUBJECT"
  echo ""
  exit 1
fi

# --- FORGE-mode trailer, if present, must be a valid value ---

FORGE_MODE_LINE=$(echo "$COMMIT_MSG" | grep -E "^FORGE-mode:")
if [ -n "$FORGE_MODE_LINE" ]; then
  FORGE_MODE=$(echo "$FORGE_MODE_LINE" | sed 's/^FORGE-mode: *//' | sed 's/[[:space:]]*$//')
  case "$FORGE_MODE" in
    Lightweight|Mid|Strict|"Full Discipline")
      ;;
    *)
      echo ""
      echo "FORGE: Commit rejected - invalid FORGE-mode value: $FORGE_MODE"
      echo "  Valid modes: Lightweight, Mid, Strict, Full Discipline (or omit the trailer)."
      echo ""
      exit 1
      ;;
  esac
fi

# --- AI attribution rejection ---

if echo "$COMMIT_MSG" | grep -qiE '(generated by|coded with|created with|authored by (claude|cursor|codex|copilot)|claude code|cursor ai|codex agent|copilot)'; then
  echo ""
  echo "FORGE: Commit rejected - AI attribution or tool-marketing text is not allowed in commit messages."
  echo ""
  echo "  Describe the work only. Do not include lines like:"
  echo "  - Generated by Claude"
  echo "  - Coded with Cursor"
  echo "  - Authored by Copilot"
  echo ""
  exit 1
fi

exit 0
