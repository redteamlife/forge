# Contract-first targets generated by forge-bootstrap.
# Merge these into your project Makefile.

OPENAPI_FILE ?= openapi.yaml
OPENAPI_GENERATED_CLIENT_DIR ?= clients/ts

.PHONY: openapi check-openapi

# Regenerate the TypeScript client from openapi.yaml. Requires
# `openapi-generator-cli` (or your preferred generator) on PATH or in Docker.
openapi:
	@command -v openapi-generator-cli >/dev/null 2>&1 || { \
	  echo "openapi-generator-cli not found. Install it or run via Docker."; exit 1; }
	openapi-generator-cli generate \
	  -i $(OPENAPI_FILE) \
	  -g typescript-fetch \
	  -o $(OPENAPI_GENERATED_CLIENT_DIR)

# Drift check: fail if the committed openapi.yaml does not match the live
# spec generated from the application. Replace `your-app dump-openapi` with
# the actual command your framework provides (FastAPI, NestJS, etc).
check-openapi:
	@tmp=$$(mktemp); \
	your-app dump-openapi > $$tmp; \
	diff -u $(OPENAPI_FILE) $$tmp || { \
	  echo "openapi.yaml is out of date. Run 'make openapi' and commit the change."; exit 1; }
