# FORGE starter ignores — merge into the project's .gitignore, then add
# stack-specific entries. Do not overwrite an existing .gitignore; append what
# is missing.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node / JS
node_modules/
dist/
*.log

# Environments / secrets
.env
.env.*

# Editor / OS
.DS_Store
*.swp

# FORGE local scratch
.tmp/
