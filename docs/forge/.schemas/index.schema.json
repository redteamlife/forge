{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FORGE task index",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "task_file"],
        "properties": {
          "id": { "type": "string", "pattern": "^TASK-[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["todo", "incomplete", "claimed", "in_progress", "implemented", "integrated", "blocked", "complete"]
          },
          "priority": { "enum": ["low", "normal", "high", "critical"] },
          "phase": { "type": "string" },
          "owner_lane": { "type": "string" },
          "owner": { "type": "string" },
          "task_file": { "type": "string", "pattern": "^docs/forge/tasks/.+\\.yaml$" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
